{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "ts_multitools:slime_state",
      "cases": [
        {
          "when": "sword",
          "model": {
            "type": "minecraft:model",
            "model": "tokorotenslime:item/slime_sword"
          }
        },
        {
          "when": "pickaxe",
          "model": {
            "type": "minecraft:model",
            "model": "tokorotenslime:item/slime_pickaxe"
          }
        },
        {
          "when": "axe",
          "model": {
            "type": "minecraft:model",
            "model": "tokorotenslime:item/slime_axe"
          }
        },
        {
          "when": "shovel",
          "model": {
            "type": "minecraft:model",
            "model": "tokorotenslime:item/slime_shovel"
          }
        },
        {
          "when": "hoe",
          "model": {
            "type": "minecraft:model",
            "model": "tokorotenslime:item/slime_hoe"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "tokorotenslime:item/slime"
      }
    },
    "on_true": {
      "type": "minecraft:range_dispatch",
      "entries": [
        {
          "model": {
            "type": "minecraft:model",
            "model": "tokorotenslime:item/slime_bow_pulling_1"
          },
          "threshold": 0.65
        },
        {
          "model": {
            "type": "minecraft:model",
            "model": "tokorotenslime:item/slime_bow_pulling_2"
          },
          "threshold": 0.9
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "tokorotenslime:item/slime_bow_pulling_0"
      },
      "property": "minecraft:use_duration",
      "scale": 0.05
    }
  }
}