{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/ts-multitools",
        "issues": "https://github.com/kasaradanamo/TS-MultiTools/issues"
	},
	"license": [
      "Source code: MIT",
      "Assets: All rights reserved"
    ],
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.kasara.ts_multitools.fabric.TSMultiTools"
		],
		"client": [
			"net.kasara.ts_multitools.fabric.TSMultiToolsClient"
		]
	},
	"mixins": [
		"ts_multitools.fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*",
		"tokorotenslime": ">=${tokorotenslime_version}"
	}
}
